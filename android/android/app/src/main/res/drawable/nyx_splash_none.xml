<?xml version="1.0" encoding="utf-8"?>
<!--
  系统 Splash 那一帧的「图标」= 什么都不画（使用者 2026-09-09 裁「启动页只留一张」）

  为什么需要这么一张空 drawable，而不是干脆不写那两个属性：
  不写 = 系统退回用 android:icon（带白瓷砖的启动器图标），那样反而多一张图 ——
  正好是他不要的那个「瓷砖」。所以必须显式指一张**全透明**的。

  于是系统那一帧只剩 windowSplashScreenBackground 那块纯色底（@color/nyx_bg），
  和应用内那一帧的令牌 bg 是同一个值，接得上；
  眼睛看到的图只有应用内那一张 —— 他选的那张。

  ★ XML 注释里不许出现两个连字符。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
